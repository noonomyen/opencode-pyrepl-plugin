{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-pyrepl",
  "version": "0.1.0",
  "type": "module",
  "description": "opencode plugin giving the agent a stateful Python REPL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noonomyen/opencode-pyrepl-plugin"
  },
  "main": "./src/pyrepl.ts",
  "exports": {
    "./server": "./src/pyrepl.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "deploy": "bun src/install.ts",
    "typecheck": "tsc --noEmit",
    "lint": "ruff check src/",
    "test": "bun test tests/",
    "test:fast": "bun test tests/protocol.test.ts tests/tools.test.ts",
    "test:slow": "bun test tests/slow.test.ts",
    "ci": "bun run typecheck && bun run lint && bun test tests/"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/node": "26.2.0",
    "typescript": "^7.0.2",
    "zod": "4.1.8"
  }
}
