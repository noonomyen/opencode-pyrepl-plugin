{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-pyrepl",
  "version": "0.1.0",
  "type": "module",
  "description": "opencode plugin giving the agent a stateful Python REPL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noonomyen/opencode-pyrepl-plugin"
  },
  "main": "./src/pyrepl.ts",
  "exports": {
    "./server": "./src/pyrepl.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0"
  },
  "scripts": {
    "deploy": "bun src/install.ts",
    "typecheck": "bun src/typecheck.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/node": "26.2.0",
    "bun-types": "1.3.14",
    "zod": "4.1.8"
  }
}
